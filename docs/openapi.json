{
  "openapi": "3.0.3",
  "info": {
    "title": "REST API Starter",
    "version": "1.0.0",
    "description": "A health check and a starter endpoint. No business models or tables are defined yet."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Check API and PostgreSQL connectivity",
        "responses": {
          "200": {
            "description": "API and database are available",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" },
                "example": { "status": "ok", "database": "connected" }
              }
            }
          },
          "503": {
            "description": "Database is unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" },
                "example": { "status": "unavailable", "database": "disconnected" }
              }
            }
          }
        }
      }
    },
    "/api/v1/starter": {
      "get": {
        "operationId": "starter",
        "summary": "Starter API response",
        "responses": {
          "200": {
            "description": "API is running; this endpoint does not query the database",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": { "message": { "type": "string", "example": "API is ready" } }
                }
              }
            }
          },
          "429": {
            "description": "More than 100 requests per minute from this client",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "database"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "unavailable"] },
          "database": { "type": "string", "enum": ["connected", "disconnected"] }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    }
  }
}
