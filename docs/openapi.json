{
  "openapi": "3.0.3",
  "info": {
    "title": "Transaction Ledger API",
    "version": "1.0.0",
    "description": "Create accounts, record credits and debits, check balances and transfer money between accounts.\n\n## Try the API\n1. Expand **Create an account** and click **Execute**. Copy the returned data.id.\n2. Paste that ID into accountId under **Credit or debit an account**. Select the credit example and execute it to add 100.00.\n3. Use the same ID to check the balance or browse history. Select the debit example to spend 30.00.\n4. Create a second account, then paste both IDs into the transfer request. Fund the source first.\n5. Use a new reference_id for each new payment. Repeating a reference returns 409 without applying it again.\n\nExample UUIDs are placeholders, not existing accounts. Copy IDs manually; Swagger does not chain requests automatically. The default server is the server serving these docs, so local docs call the local API and hosted docs call the hosted API. **Execute performs real writes; use test data only.**\n\n## Conventions\n- POST bodies use application/json and must not exceed 32 KB. Unknown body fields and history query parameters are rejected.\n- Accounts start at zero. IDs and timestamps are generated by the server. Transactions cannot be edited or deleted.\n- One currency, two decimal places. Amounts must be positive with up to 16 integer digits. Send strings to avoid client-side precision loss; monetary responses are strings.\n- Names, references and descriptions are trimmed. References are case-sensitive and account-scoped.\n- Balance changes and records commit atomically. Rejected requests do not change balances.\n- API routes allow 100 requests per minute per client IP. Wait before retrying a 429 response.\n- X-Request-Id is returned on responses; ordinary API errors also include error.requestId. Health failures use a separate status/database body.\n\n## Evaluation scope\nNo authentication or account ownership checks are implemented. Anyone with the URL can use the API. Do not submit real financial or personal data."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server (recommended; no cross-origin request)"
    },
    {
      "url": "https://transaction-ledger-api-qce8.onrender.com",
      "description": "Hosted evaluation API (test data only; cross-origin access depends on CORS configuration)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Check database connectivity",
        "responses": {
          "200": {
            "description": "Connected",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "database": "connected"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated request identifier for troubleshooting.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "example": {
                  "status": "unavailable",
                  "database": "disconnected"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated request identifier for troubleshooting.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        "tags": ["Service"],
        "description": "Runs SELECT 1 against PostgreSQL without requiring ledger tables. A 200 confirms database connectivity, not migrations. Outside the /api rate limit."
      }
    },
    "/api/v1/starter": {
      "get": {
        "operationId": "starter",
        "summary": "Starter endpoint",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "example": {
                  "message": "API is ready"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated request identifier for troubleshooting.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        "tags": ["Service"],
        "description": "Static readiness response; does not query the database. Use /health for database connectivity."
      }
    },
    "/api/v1/accounts": {
      "post": {
        "operationId": "createAccount",
        "summary": "Create an account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccount"
              },
              "examples": {
                "account": {
                  "summary": "Create a zero-balance account",
                  "value": {
                    "name": "Alice"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Account"
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": "ecb4dc3b-c6e0-46bd-baa3-b9be5cb68562",
                    "name": "Alice",
                    "balance": "0.00",
                    "created_at": "2026-10-28T10:00:00.000Z"
                  }
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated request identifier for troubleshooting.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/MediaType"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "tags": ["Accounts"],
        "description": "Provide only name (1–100 characters after trimming). The server generates a UUID, timestamp and 0.00 balance. Client-supplied balance, id, created_at and unknown fields are rejected. Names need not be unique. Copy data.id for subsequent requests."
      }
    },
    "/api/v1/accounts/{accountId}/balance": {
      "parameters": [
        {
          "$ref": "#/components/parameters/AccountId"
        }
      ],
      "get": {
        "operationId": "getBalance",
        "summary": "Get account balance",
        "responses": {
          "200": {
            "description": "Balance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["account_id", "balance"],
                      "properties": {
                        "account_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "balance": {
                          "type": "string",
                          "example": "100.00"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "account_id": "ecb4dc3b-c6e0-46bd-baa3-b9be5cb68562",
                    "balance": "100.00"
                  }
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated request identifier for troubleshooting.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "tags": ["Accounts"],
        "description": "Returns the committed balance as a decimal string. Replace accountId with an ID from Create an account. Malformed UUIDs return 400; valid UUIDs for missing accounts return 404."
      }
    },
    "/api/v1/accounts/{accountId}/transactions": {
      "parameters": [
        {
          "$ref": "#/components/parameters/AccountId"
        }
      ],
      "post": {
        "operationId": "addTransaction",
        "summary": "Credit or debit an account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransaction"
              },
              "examples": {
                "credit": {
                  "summary": "Add 100.00",
                  "value": {
                    "type": "credit",
                    "amount": "100.00",
                    "description": "Opening deposit",
                    "reference_id": "deposit-001"
                  }
                },
                "debit": {
                  "summary": "Spend 30.00 (requires funds)",
                  "value": {
                    "type": "debit",
                    "amount": "30.00",
                    "description": "Example purchase",
                    "reference_id": "purchase-001"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction and updated balance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "transaction": {
                          "$ref": "#/components/schemas/Transaction"
                        },
                        "balance": {
                          "type": "string",
                          "example": "100.00"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "transaction": {
                      "id": "ac1d0748-8794-47cc-898c-544b2b5ae26f",
                      "account_id": "ecb4dc3b-c6e0-46bd-baa3-b9be5cb68562",
                      "type": "credit",
                      "amount": "100.00",
                      "description": "Opening deposit",
                      "reference_id": "deposit-001",
                      "created_at": "2026-10-28T10:00:00.000Z"
                    },
                    "balance": "100.00"
                  }
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated request identifier for troubleshooting.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/MediaType"
          },
          "422": {
            "$ref": "#/components/responses/OutOfRange"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "tags": ["Transactions"],
        "description": "Replace accountId with a real account ID. Credits add funds; debits subtract funds only if the balance is sufficient. The balance and immutable record commit together. References are trimmed, case-sensitive and unique within this account. Duplicates return 409 even if other fields differ; they are not successful replays. The same reference may be used on another account. Select a request example below; fund the account before trying a debit."
      },
      "get": {
        "operationId": "getHistory",
        "summary": "Get latest-first history",
        "description": "Ordered by created_at DESC, then id DESC. Omit type for both credits and debits. Totals reflect the selected filter. Count and records share one snapshot within this request; separate pages can change as new records arrive. Empty history has total_records=0 and total_pages=0. Pages beyond the end return data=[] with the requested page and actual totals. Unknown query parameters are rejected.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["credit", "debit"]
            },
            "description": "Optional type filter; omit for both types."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            },
            "description": "Positive page number, starting at 1; maximum 1000000."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Records per page, from 1 to 100; defaults to 20."
          }
        ],
        "responses": {
          "200": {
            "description": "History",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Transaction"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "total_records": {
                          "type": "integer"
                        },
                        "total_pages": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": "ac1d0748-8794-47cc-898c-544b2b5ae26f",
                      "account_id": "ecb4dc3b-c6e0-46bd-baa3-b9be5cb68562",
                      "type": "credit",
                      "amount": "100.00",
                      "description": "Opening deposit",
                      "reference_id": "deposit-001",
                      "created_at": "2026-10-28T10:00:00.000Z"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 20,
                    "total_records": 1,
                    "total_pages": 1
                  }
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated request identifier for troubleshooting.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "tags": ["Transactions"]
      }
    },
    "/api/v1/transfers": {
      "post": {
        "operationId": "transfer",
        "summary": "Transfer money atomically",
        "description": "Create two accounts and fund the source first. Replace both example UUIDs. Both accounts must exist and differ; the source needs sufficient funds. The reference must be unused on both accounts. One debit and one credit use the same amount, description and reference. Both balances and records commit together, or everything rolls back. Retrying a completed transfer with the same reference returns 409.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransfer"
              },
              "examples": {
                "transfer": {
                  "summary": "Transfer 30.00 (replace both UUIDs)",
                  "value": {
                    "source_account_id": "ecb4dc3b-c6e0-46bd-baa3-b9be5cb68562",
                    "destination_account_id": "ad91d1c1-77a9-46c1-b01c-66f83a0fab52",
                    "amount": "30.00",
                    "description": "Shared expense",
                    "reference_id": "transfer-001"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "debit": {
                          "$ref": "#/components/schemas/Transaction"
                        },
                        "credit": {
                          "$ref": "#/components/schemas/Transaction"
                        },
                        "source_balance": {
                          "type": "string"
                        },
                        "destination_balance": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "debit": {
                      "id": "ac1d0748-8794-47cc-898c-544b2b5ae26f",
                      "account_id": "ecb4dc3b-c6e0-46bd-baa3-b9be5cb68562",
                      "type": "debit",
                      "amount": "30.00",
                      "description": "Shared expense",
                      "reference_id": "transfer-001",
                      "created_at": "2026-10-28T10:00:00.000Z"
                    },
                    "credit": {
                      "id": "c165d2e5-79cd-4e2c-824b-90ed557bf2ca",
                      "account_id": "ad91d1c1-77a9-46c1-b01c-66f83a0fab52",
                      "type": "credit",
                      "amount": "30.00",
                      "description": "Shared expense",
                      "reference_id": "transfer-001",
                      "created_at": "2026-10-28T10:00:00.000Z"
                    },
                    "source_balance": "70.00",
                    "destination_balance": "30.00"
                  }
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated request identifier for troubleshooting.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/MediaType"
          },
          "422": {
            "$ref": "#/components/responses/OutOfRange"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "tags": ["Transfers"]
      }
    }
  },
  "components": {
    "parameters": {
      "AccountId": {
        "name": "accountId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Existing UUID returned by Create an account. Replace this placeholder before executing.",
        "example": "ecb4dc3b-c6e0-46bd-baa3-b9be5cb68562"
      }
    },
    "responses": {
      "Invalid": {
        "description": "Invalid body, UUID, amount, type or pagination",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "validation": {
                "value": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Request validation failed",
                    "details": [
                      {
                        "field": "amount",
                        "message": "Amount must be greater than 0"
                      }
                    ],
                    "requestId": "8d506788-a797-49da-a043-24b274023e91"
                  }
                }
              },
              "malformedJson": {
                "value": {
                  "error": {
                    "code": "INVALID_JSON",
                    "message": "Request body is not valid JSON",
                    "requestId": "8d506788-a797-49da-a043-24b274023e91"
                  }
                }
              }
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "description": "Server-generated request identifier for troubleshooting.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "NotFound": {
        "description": "Account not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ACCOUNT_NOT_FOUND",
                "message": "Account not found",
                "requestId": "8d506788-a797-49da-a043-24b274023e91"
              }
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "description": "Server-generated request identifier for troubleshooting.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "Conflict": {
        "description": "DUPLICATE_TRANSACTION or INSUFFICIENT_BALANCE. No changes persisted.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "duplicate": {
                "summary": "Reference already used; no new transaction",
                "value": {
                  "error": {
                    "code": "DUPLICATE_TRANSACTION",
                    "message": "Transaction reference already exists for this account",
                    "details": {
                      "account_id": "ecb4dc3b-c6e0-46bd-baa3-b9be5cb68562",
                      "transaction_id": "ac1d0748-8794-47cc-898c-544b2b5ae26f"
                    },
                    "requestId": "8d506788-a797-49da-a043-24b274023e91"
                  }
                }
              },
              "insufficientFunds": {
                "summary": "Debit exceeds available balance",
                "value": {
                  "error": {
                    "code": "INSUFFICIENT_BALANCE",
                    "message": "Account has insufficient balance",
                    "requestId": "8d506788-a797-49da-a043-24b274023e91"
                  }
                }
              }
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "description": "Server-generated request identifier for troubleshooting.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "MediaType": {
        "description": "Expected application/json",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "UNSUPPORTED_MEDIA_TYPE",
                "message": "Content-Type must be application/json",
                "requestId": "8d506788-a797-49da-a043-24b274023e91"
              }
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "description": "Server-generated request identifier for troubleshooting.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "OutOfRange": {
        "description": "Amount or resulting balance exceeds supported range",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "AMOUNT_OUT_OF_RANGE",
                "message": "Amount or resulting balance exceeds the supported range",
                "requestId": "8d506788-a797-49da-a043-24b274023e91"
              }
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "description": "Server-generated request identifier for troubleshooting.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "RATE_LIMITED",
                "message": "Too many requests",
                "requestId": "8d506788-a797-49da-a043-24b274023e91"
              }
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "description": "Server-generated request identifier for troubleshooting.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "Internal": {
        "description": "Unexpected error; writes rolled back",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "INTERNAL_ERROR",
                "message": "An unexpected error occurred",
                "requestId": "8d506788-a797-49da-a043-24b274023e91"
              }
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "description": "Server-generated request identifier for troubleshooting.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "Request body exceeds the 32 KB limit",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "PAYLOAD_TOO_LARGE",
                "message": "Request body exceeds the 32 KB limit",
