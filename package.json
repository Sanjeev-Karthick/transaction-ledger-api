{
  "name": "transaction-ledger-api",
  "version": "1.0.0",
  "private": true,
  "description": "JavaScript REST API starter with PostgreSQL, OpenAPI and Docker",
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "debug": "node --env-file-if-exists=.env --inspect src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:validate": "node scripts/validate-openapi.js",
    "check": "npm run lint && npm run format:check && npm test && npm run docs:validate"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  }
}
