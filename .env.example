NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local-only credentials. Replace before using a shared environment.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_local_only
POSTGRES_DB=ledger
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ledger:ledger_local_only@localhost:5432/ledger
# Used only by integration tests; must be a different, disposable database.
TEST_DATABASE_URL=postgresql://ledger:ledger_local_only@localhost:5432/ledger_test
DB_SSL=false
# Optional PEM file for a private certificate authority. TLS always verifies certificates.
DB_SSL_CA_FILE=
DOCS_ENABLED=true
# Comma-separated browser origins; empty means no cross-origin access.
CORS_ORIGINS=